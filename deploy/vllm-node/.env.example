# Pin the engine tag; see https://github.com/vllm-project/vllm/releases for newer releases.
VLLM_IMAGE=vllm/vllm-openai:v0.30.0

# Replace with a Hugging Face model supported by your GPU and vLLM.
VLLM_MODEL=Qwen/Qwen3-8B
PUBLIC_MODEL_NAME=Qwen3-8B
VLLM_MAX_MODEL_LEN=8192

# Public HTTPS address of your OpenMyModel server and its admin password.
CLOUD_URL=https://api.example.com
ADMIN_PASSWORD=replace-with-your-server-admin-password

# Give this node a unique, stable ID and a readable display name.
NODE_ID=vllm-linux-01
NODE_NAME=vllm-linux-01

# Use the same long random value here and in the OpenMyModel node settings.
NODE_API_KEY=replace-with-a-long-random-node-key

# Only needed for gated/private Hugging Face models.
HF_TOKEN=
